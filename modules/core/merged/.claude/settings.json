{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} \"$CLAUDE_PROJECT_DIR/scripts/kb.py\" session-start",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} \"$CLAUDE_PROJECT_DIR/scripts/export_session.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} \"$CLAUDE_PROJECT_DIR/scripts/export_session.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
